# Supabase Configuration (Local Development)
# These are the default values for local Supabase development
# DO NOT use these values in production!

# Supabase API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Studio
STUDIO_PORT=54323

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Storage (S3)
S3_URL=http://127.0.0.1:54321/storage/v1/s3
S3_ACCESS_KEY=625729a08b95bf1b7ff351a663f3a23c
S3_SECRET_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
S3_REGION=local

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include: http://127.0.0.1:54321/auth/v1/callback
# See docs/GOOGLE_OAUTH_SETUP.md for detailed setup instructions
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
ENABLE_GOOGLE_OAUTH=true

# Frontend Google OAuth (for direct client usage if needed)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
